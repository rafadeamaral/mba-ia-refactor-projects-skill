# Copie para .env e preencha com valores reais. O arquivo .env NÃO é versionado.

# Obrigatório em produção. Sem esta variável a aplicação gera um segredo efêmero por boot.
SECRET_KEY=troque-por-um-valor-aleatorio-longo

# Nunca "true" em produção: o debugger do Werkzeug expõe console interativo.
DEBUG=false

DATABASE_PATH=loja.db

HOST=127.0.0.1
PORT=5000

LOG_LEVEL=INFO

# Origens permitidas para CORS, separadas por vírgula. Evite "*".
CORS_ORIGINS=http://localhost:3000

# Validade do token emitido em POST /login, em segundos.
# A autenticação é obrigatória nas rotas administrativas e mutáveis e NÃO tem chave para desligar:
# com SECRET_KEY efêmera, os tokens simplesmente deixam de valer a cada restart.
TOKEN_TTL_SEGUNDOS=3600
