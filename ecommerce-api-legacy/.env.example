# Copie para .env e preencha com valores reais. O arquivo .env NÃO é versionado.

NODE_ENV=development
PORT=3000

# Caminho do banco. A versão anterior usava ':memory:' fixo no código, o que descartava
# todos os pagamentos a cada restart. Use ':memory:' apenas em teste.
DATABASE_PATH=./data/lms.db

LOG_LEVEL=info

# Chave do gateway de pagamento. NUNCA versione a chave real — a versão anterior mantinha uma
# chave pk_live_ de produção no código-fonte, que segue exposta no histórico do Git.
PAYMENT_GATEWAY_KEY=

SMTP_HOST=
SMTP_USER=

# Credencial das rotas administrativas (GET /api/admin/financial-report, DELETE /api/users/:id).
# Obrigatória em produção. Se ficar vazia, o boot gera uma chave aleatória e a imprime no log:
# as rotas continuam fechadas para quem não tem a chave — não há como deixá-las anônimas.
ADMIN_API_KEY=
